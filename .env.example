# Copy to .env for local development. On Netlify, set the same names in Site configuration → Environment variables.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/yogacharya
JWT_SECRET=paste-64-random-characters-here   # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# First login creates this admin (only while there are no users yet). Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password
